DATABASE_URL="postgresql://transfer_hub_runtime:CHANGEME@localhost:5432/transfer_hub"

# NOT auto-loaded by Prisma — this is a documentation convention, not a var
# any script reads automatically. When running `npm run migrate` /
# `npm run migrate:deploy` (prisma migrate dev/deploy — needs a role that can
# create/drop the shadow DB and run DDL), override DATABASE_URL on the
# command line with this value instead, e.g.:
#   DATABASE_URL="$MIGRATE_DATABASE_URL" npm run migrate
# Deliberately never the default DATABASE_URL: the API server + BullMQ
# workers must never run with DDL privileges. See backend/prisma/roles.sql
# and docs/polp-security-dev-plan.md Phase 3.
MIGRATE_DATABASE_URL="postgresql://postgres:password@localhost:5432/transfer_hub"
PORT=3001
REDIS_URL="redis://localhost:6379"
SPORTMONKS_API_KEY=""
SPORTMONKS_BASE_URL="https://api.sportmonks.com/v3/football"
API_FOOTBALL_KEY=""
RUMOUR_INGEST_INTERVAL_MINUTES=30
PLAYER_SYNC_INTERVAL_HOURS=24
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Remove-ads one-time payment (£0.99) — get test keys from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""

# Auth session signing — generate with `openssl rand -hex 32`
JWT_SECRET=""

# ML scoring service (ml-service/) — leave unset to use the built-in heuristic only.
# Falls back to the heuristic automatically on error/timeout even when set.
ML_SCORING_URL=""
ML_SCORING_TIMEOUT_MS=1500

# Shared secret sent as X-ML-Service-Key to ml-service/. Must match
# ml-service's ML_SERVICE_KEY env var exactly (see ml-service/README.md).
# Leave both unset for local dev — ml-service treats a missing key as
# "auth disabled", not "reject everything". Set in any shared/prod
# environment — see docs/polp-security-dev-plan.md Phase 2.
ML_SERVICE_KEY=""
