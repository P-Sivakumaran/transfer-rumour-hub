DATABASE_URL="postgresql://postgres:password@localhost:5432/transfer_hub"
PORT=3001
REDIS_URL="redis://localhost:6379"
SPORTMONKS_API_KEY=""
SPORTMONKS_BASE_URL="https://api.sportmonks.com/v3/football"
API_FOOTBALL_KEY=""
RUMOUR_INGEST_INTERVAL_MINUTES=30
PLAYER_SYNC_INTERVAL_HOURS=24
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Remove-ads one-time payment (£0.99) — get test keys from dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""

# Auth session signing — generate with `openssl rand -hex 32`
JWT_SECRET=""

# ML scoring service (ml-service/) — leave unset to use the heuristic engine only.
# See ml-service/README.md before setting this; the model won't exist until
# enough rumours have resolved to COMPLETED/FAILED/DENIED to train on.
MODEL_SERVICE_URL=""
